# ==============================================================================
# InsightPilot AI - Root Environment Template (.env.example)
# Copy this file to .env or configure these variables in production / cloud hosting.
# ==============================================================================

# Backend Port Configuration
PORT=8001
HOST=127.0.0.1

# Optional: OpenAI API Key for natural language chat & enriched narrative generation
# (The platform contains built-in zero-hallucination deterministic engines that work 100% offline without this key)
OPENAI_API_KEY=

# Storage & SQLite Database Paths
DATABASE_URL=sqlite:///./insightpilot.db
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
MODEL_DIR=./storage/models
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_TYPES=csv,xlsx,xls,tsv

# Frontend API Connection (used when building/running frontend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
